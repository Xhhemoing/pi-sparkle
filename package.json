{
  "name": "pi-sparkle",
  "version": "0.1.0-preview.3",
  "private": true,
  "description": "Evidence-bound changes for Pi: isolated candidates, independent checks and explicit application",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xhhemoing/pi-sparkle.git"
  },
  "bugs": {
    "url": "https://github.com/Xhhemoing/pi-sparkle/issues"
  },
  "homepage": "https://github.com/Xhhemoing/pi-sparkle#readme",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "bin": {
    "pi-sparkle": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    ".agents/skills",
    "prompts",
    "examples",
    "sdk",
    "schema"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-sparkle/index.ts"
    ],
    "skills": [
      ".agents/skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "cli": "tsx src/cli/main.ts",
    "pi-sparkle": "node dist/cli/main.js",
    "pi-compat": "tsx src/cli/main.ts pi-compat",
    "pi:latest": "node scripts/pi-latest-check.mjs",
    "pi:probe": "node scripts/pi-compat-probe.mjs",
    "test": "node scripts/run-tests.mjs",
    "workflow:check": "node scripts/workflow-check.mjs",
    "schema:taskspec": "node --import tsx scripts/generate-task-spec-schema.mjs",
    "status": "node scripts/status.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "gate": "pnpm workflow:check && pnpm typecheck && pnpm lint && pnpm test -- --test-concurrency=1 && pnpm build",
    "invocation:probe": "node scripts/invocation-lock-probe.mjs",
    "security:probe": "node scripts/security-probe.mjs",
    "crash:probe": "node scripts/crash-probe.mjs",
    "kernel-reuse:probe": "node scripts/kernel-reuse-probe.mjs",
    "retention:probe": "node scripts/retention-probe.mjs",
    "bench:runtime": "node scripts/bench-runtime.mjs",
    "preview:probe": "node scripts/preview-release-probe.mjs",
    "market-eval:probe": "node scripts/market-eval-probe.mjs",
    "prerelease": "pnpm preview:probe && pnpm gate && pnpm security:probe && pnpm pi:probe",
    "prepublishOnly": "pnpm prerelease"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
