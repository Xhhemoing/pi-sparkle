{
  "name": "pi-sparkle",
  "version": "0.1.0",
  "private": true,
  "description": "Project-development multi-agent runtime built on Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xhhemoing/pi-sparkle.git"
  },
  "bugs": {
    "url": "https://github.com/Xhhemoing/pi-sparkle/issues"
  },
  "homepage": "https://github.com/Xhhemoing/pi-sparkle#readme",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "bin": {
    "pi-sparkle": "dist/cli/main.js"
  },
    "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    ".agents/skills",
    "prompts",
    "examples"
  ],
  "pi": {
    "skills": [
      ".agents/skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "cli": "tsx src/cli/main.ts",
    "pi-sparkle": "node dist/cli/main.js",
    "pi-compat": "tsx src/cli/main.ts pi-compat",
    "pi:latest": "node scripts/pi-latest-check.mjs",
    "pi:probe": "node scripts/pi-compat-probe.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "invocation:probe": "node scripts/invocation-lock-probe.mjs",
    "security:probe": "node scripts/security-probe.mjs",
    "crash:probe": "node scripts/crash-probe.mjs",
    "kernel-reuse:probe": "node scripts/kernel-reuse-probe.mjs",
    "retention:probe": "node scripts/retention-probe.mjs",
    "bench:runtime": "node scripts/bench-runtime.mjs",
    "prerelease": "pnpm gate && pnpm security:probe && pnpm pi:probe",
    "prepublishOnly": "pnpm prerelease"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
