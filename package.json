{
  "name": "pi-sparkle",
  "version": "0.1.0",
  "private": true,
  "description": "Project-development multi-agent runtime built on Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "bin": {
    "pi-sparkle": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".agents/skills",
    "prompts"
  ],
  "pi": {
    "skills": [
      ".agents/skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "cli": "tsx src/cli/main.ts",
    "pi-sparkle": "node dist/cli/main.js",
    "pi-compat": "tsx src/cli/main.ts pi-compat",
    "pi:latest": "node scripts/pi-latest-check.mjs",
    "pi:probe": "node scripts/pi-compat-probe.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "invocation:probe": "node scripts/invocation-lock-probe.mjs",
    "security:probe": "node scripts/security-probe.mjs",
    "preview:probe": "node scripts/preview-release-probe.mjs",
    "prerelease": "pnpm preview:probe && pnpm gate && pnpm security:probe && pnpm pi:probe"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
