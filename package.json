{
  "name": "pi-sparkle",
  "version": "0.1.0",
  "private": true,
  "description": "Project-development multi-agent runtime built on Pi",
  "keywords": ["pi-package"],
  "type": "module",
  "bin": {
    "pi-sparkle": "dist/cli/main.js"
  },
  "files": ["dist", "README.md", "LICENSE", ".agents/skills", "prompts"],
  "pi": {
    "skills": [".agents/skills"],
    "prompts": ["./prompts"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "cli": "tsx src/cli/main.ts",
    "pi-sparkle": "node dist/cli/main.js",
    "test": "tsx --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
