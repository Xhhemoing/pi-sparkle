# pi-sparkle environment template.
# Copy to .env and fill in real values. NEVER commit .env — only this template
# is tracked (see .gitignore). All values below are obvious placeholders.
#
# Nothing here is required for the supported developer-preview path: the fake
# executor (`pnpm cli run --project ... --objective ...`) needs no credentials.

# --- Real provider credentials (opt-in, `--executor pi`) --------------------
# Pi-native per-provider keys. Stored credentials in ~/.pi-sparkle/auth.json
# take precedence over these.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Custom OpenRouter-backed provider declared in providers.json. The variable
# name is whatever `envVar` that provider entry declares; this is the one used
# by the 2026-08-22 provider smoke.
OPENROUTER_OX_API_KEY=replace-me

# --- Compatibility override for the default provider ------------------------
# Single-provider shorthand honoured by the Pi adapter.
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini
PI_API_KEY=sk-...

# Optional default fast model (overridden by --fast-model).
PI_FAST_MODEL=openai/gpt-4o-mini

# Optional reasoning budget: off | minimal | low | medium | high | xhigh
PI_THINKING_LEVEL=off

# --- Test / tooling switches ------------------------------------------------
# Set to 1 to run the real-provider smoke test, which is skipped otherwise.
# Requires PI_PROVIDER and PI_MODEL (plus credentials).
PI_SMOKE=0

# State root used by the provider smoke test. Defaults to ~/.pi-sparkle.
PI_STATE_ROOT=

# Set to 0 to keep the post-run adaptation loop from proposing candidates.
# Collection still happens; promotion always requires `adapt promote --approve`.
SPARKLE_AUTO_ADAPT=1

# Comma-separated security-probe finding ids to waive. Leave this EMPTY: the
# gate is GREEN as of 2026-08-25, the waiver register in
# docs/specs/release-gate.md is empty, and both CI and `pnpm prerelease` run
# the probe with no waiver. A waiver must be registered (reason + expiry)
# before use, and `packaged-secrets` is never waivable — the probe ignores it
# in this list.
SECURITY_WAIVER=
